# DATABASE_URL: PostgreSQL connection string (e.g. postgresql://user:password@localhost:5432/aibets)
DATABASE_URL=""

# DEEPSEEK_API_KEY: Required for DeepSeek AI API calls (https://platform.deepseek.com).
# Configure this via your environment variables or secrets.
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"

# DEEPSEEK_MODEL: (Optional) Model name to use: deepseek-chat (default) or deepseek-reasoner
DEEPSEEK_MODEL="deepseek-chat"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
